{
  "name": "sanrenjz-tools",
  "version": "2.27.0",
  "description": "三人聚智效率工具 - 基于JavaScript的插件平台",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 && electron .",
    "dev": "electron . --inspect=9229",
    "build": "electron-builder",
    "build-all": "electron-builder --win --mac --linux",
    "build-win": "electron-builder --win --x64",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "release-win": "electron-builder --win --x64 --publish always",
    "dist": "npm run build-all",
    "clean": "rimraf dist build-output *.log *.tmp *.temp settings.json plugin-data user-data",
    "rebuild": "npm run clean && npm install && npm start",
    "test": "echo \"启动应用进行测试...\" && npm start",
    "test:logic": "node tests/logic.test.js && node tests/plugin-store.test.js && node tests/plugin-window-ready.test.js && node tests/commander-router.test.js && node tests/commander-jev.test.js && node tests/plugin-market.test.js && node tests/ai-runtime.test.js && node tests/ai-provider-manager.test.js && node tests/opencode-runtime.test.js && node tests/opencode-profile.test.js && node tests/opencode-lifecycle.test.js",
    "generate:plugins": "electron scripts/render-plugin-icons.js",
    "generate:icons": "electron scripts/render-plugin-icons.js",
    "test:plugins": "node scripts/validate-plugins.js && node tests/main-runtime-paths.test.js && node tests/plugin-store.test.js && node tests/plugin-window-ready.test.js && node tests/commander-router.test.js && node tests/commander-jev.test.js && node tests/plugin-market.test.js && node tests/ai-runtime.test.js && node tests/ai-provider-manager.test.js && node tests/opencode-runtime.test.js && node tests/opencode-profile.test.js && node tests/opencode-lifecycle.test.js && node tests/ai-document.test.js && node tests/ai-meeting.test.js",
    "test:plugins:electron": "electron tests/electron-plugin-smoke.js && electron tests/password-manager-electron.test.js && electron tests/account-manager-electron.test.js && electron tests/ai-document-electron.test.js && electron tests/ai-meeting-electron.test.js",
    "test:password-plugin": "electron tests/password-manager-electron.test.js",
    "test:account-plugin": "electron tests/account-manager-electron.test.js",
    "test:hooks": "node tests/windows-hook-runtime.test.js",
    "test:plugins:gallery": "electron tests/electron-plugin-gallery.js",
    "test:plugins:icons": "electron tests/electron-icon-gallery.js",
    "preinstall": "echo \"检查Node.js环境...\"",
    "postinstall": "electron-builder install-app-deps && echo \"依赖安装完成，可以运行 npm start 启动应用\"",
    "test:remote": "node tests/remote-protocol.test.js && node tests/remote-chat.test.js && electron tests/remote-without-cast.test.js"
  },
  "author": {
    "name": "余汉波",
    "email": "yuhanbo758@sanrenjz.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuhanbo758/sanrenjz-tools.git"
  },
  "keywords": [
    "electron",
    "plugins",
    "utools",
    "efficiency",
    "javascript"
  ],
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "axios": "^1.6.5",
    "better-sqlite3": "^9.4.5",
    "electron-updater": "^6.8.3",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "jsqr": "^1.4.0",
    "mammoth": "^1.12.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^2.16.105",
    "qrcode": "^1.5.4",
    "read-excel-file": "6.0.3",
    "selfsigned": "2.4.1",
    "word-extractor": "^1.0.4",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "23.6.0",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.sanrenjz.tools",
    "productName": "三人聚智-效率工具",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "files": [
      "**/*",
      "!node_modules/**/*",
      "node_modules/@electron/remote/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/universalify/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/pdf-parse/**/*",
      "node_modules/mammoth/**/*",
      "node_modules/word-extractor/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/read-excel-file/**/*",
      "node_modules/fflate/**/*",
      "node_modules/unzipper/**/*",
      "node_modules/duplexer2/**/*",
      "node_modules/node-int64/**/*",
      "node_modules/dommatrix/**/*",
      "node_modules/web-streams-polyfill/**/*",
      "node_modules/saxes/**/*",
      "node_modules/xmlchars/**/*",
      "node_modules/yauzl/**/*",
      "node_modules/fd-slicer/**/*",
      "node_modules/pend/**/*",
      "node_modules/buffer-crc32/**/*",
      "node_modules/@xmldom/xmldom/**/*",
      "node_modules/argparse/**/*",
      "node_modules/base64-js/**/*",
      "node_modules/bluebird/**/*",
      "node_modules/dingbat-to-unicode/**/*",
      "node_modules/jszip/**/*",
      "node_modules/lie/**/*",
      "node_modules/immediate/**/*",
      "node_modules/pako/**/*",
      "node_modules/readable-stream/**/*",
      "node_modules/inherits/**/*",
      "node_modules/string_decoder/**/*",
      "node_modules/safe-buffer/**/*",
      "node_modules/util-deprecate/**/*",
      "node_modules/setimmediate/**/*",
      "node_modules/lop/**/*",
      "node_modules/duck/**/*",
      "node_modules/underscore/**/*",
      "node_modules/option/**/*",
      "node_modules/path-is-absolute/**/*",
      "node_modules/xmlbuilder/**/*",
      "node_modules/node-ensure/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "!dist",
      "!build-output",
      "!*.log",
      "!*.tmp",
      "!*.temp",
      "!settings.json",
      "!plugin-data",
      "!user-data",
      "node_modules/ws/**/*",
      "node_modules/selfsigned/**/*",
      "node_modules/node-forge/**/*",
      "!android/**",
      "!app/software/sanrenjz-tools-cast-receiver/**",
      "!app/software/sanrenjz-tools-reading-learning/**",
      "!server/**",
      "node_modules/qrcode/**/*",
      "node_modules/dijkstrajs/**/*",
      "node_modules/pngjs/**/*",
      "!scripts/mobile-deploy/**",
      "!tests/remote-main-live.js",
      "!tests/remote-debug-phone.js",
      "!tests/remote-live-inspect.js",
      "!dist/**",
      "!build-output/**",
      "!tests/**",
      "!**/AGENTS.md",
      "!**/PROJECT_MEMORY.md",
      "!.trae/**"
    ],
    "asarUnpack": [
      "node_modules/@electron/remote/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/universalify/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/pdf-parse/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/node-ensure/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app",
        "filter": [
          "**/*",
          "!software/sanrenjz-tools-cast-receiver/**",
          "!software/sanrenjz-tools-reading-learning/**"
        ]
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.icns",
          "icon.png"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "sanrenjz-tools-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": false,
      "include": "build/installer.nsh",
      "shortcutName": "三人聚智效率工具",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "sanrenjz-tools-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "artifactName": "sanrenjz-tools-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "三人聚智效率工具",
      "icon": "build/icon.icns",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "sanrenjz-tools-${version}-linux-${arch}.${ext}",
      "desktop": {
        "Name": "三人聚智效率工具",
        "Comment": "基于JavaScript的插件平台",
        "Categories": "Utility;Development;"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "yuhanbo758",
      "repo": "sanrenjz-tools",
      "releaseType": "release"
    },
    "generateUpdatesFilesForAllChannels": true
  },
  "homepage": "https://github.com/yuhanbo758/sanrenjz-tools",
  "bugs": {
    "url": "https://github.com/yuhanbo758/sanrenjz-tools/issues"
  }
}
