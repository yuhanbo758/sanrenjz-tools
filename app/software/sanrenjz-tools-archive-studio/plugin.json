{
  "pluginName": "压缩包工作台",
  "description": "创建、预览并安全解压 ZIP，拦截越界路径。",
  "version": "2.0.0",
  "author": "三人聚智",
  "category": "效率工具",
  "main": "index.html",
  "logo": "logo.ico",
  "preload": "preload.js",
  "features": [
    {
      "code": "plugin-market-archive-tool",
      "explain": "ZIP 压缩包",
      "description": "创建、预览并安全解压 ZIP，拦截越界路径。",
      "cmds": [
        "zip",
        "压缩包",
        "解压",
        {
          "type": "over",
          "label": "用压缩包工作台处理",
          "minLength": 1,
          "maxLength": 200000
        }
      ],
      "icon": "logo.ico",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "mode": "none",
      "superPanel": true,
      "category": "效率工具",
      "priority": 20,
      "useClipboardText": true
