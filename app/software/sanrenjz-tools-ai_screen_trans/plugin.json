{
  "pluginName": "AI 屏幕翻译",
  "description": "支持框选截图、独立 OCR 与翻译分步处理，以及多模态模型一次识别并翻译。",
  "version": "1.3.0",
  "updatedAt": "2026-09-20",
  "author": "余汉波",
  "category": "AI 工具",
  "main": "index.html",
  "logo": "logo.ico",
  "preload": "preload.js",
  "features": [
    {
      "code": "ai-screen-text-translate",
      "explain": "文本翻译",
      "description": "选中文本或复制文本后使用，自动进行中英互译",
      "cmds": [
        "翻译",
        "文本翻译",
        "translate",
        "DeepSeek V4",
        {
          "type": "over",
          "label": "文本翻译",
          "minLength": 1,
          "maxLength": 10000
        }
      ],
      "icon": "logo.ico",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "mode": "none",
      "superPanel": true,
      "priority": 100
    },
    {
      "code": "ai-screen-ocr-translate",
      "explain": "截图翻译",
      "description": "直接框选屏幕区域，可仅 OCR 并复制原文，也可继续翻译",
      "cmds": [
        "截图翻译",
        "截图识别",
        "OCR识别",
        "OCR翻译",
        "screen translate",
        {
          "type": "img",
          "label": "截图翻译"
        }
      ],
      "icon": "logo.ico",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "mode": "none",
      "startHidden": true,
      "superPanel": true,
      "priority": 100
    }
  ],
  "pluginSetting": {
    "width": 900,
    "height": 620,
    "single": true,
    "autoHideMenuBar": true,
    "menuBarVisible": false
  }
}
